<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.oryxlabs</groupId>
    <artifactId>oryxos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OryxOS Parent</name>
    <description>企业 Agent 操作系统（Agent Harness OS）—— 核心阶段父 POM，聚合 9 个模块</description>

    <modules>
        <module>oryxos-core</module>
        <module>oryxos-provider</module>
        <module>oryxos-memory</module>
        <module>oryxos-tool</module>
        <module>oryxos-channel-cli</module>
        <module>oryxos-web</module>
        <module>oryxos-storage</module>
        <module>oryxos-cli</module>
        <module>oryxos-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- CVE 修复版(2026-10-12):Boot 3.5.16 BOM 托管的 tomcat 10.1.55 / sqlite-jdbc
             3.49.1.0 含多个 CVSS≥7 CVE,官方已在同发布线出修复版;版本号集中在此,
             实际覆盖由 dependencyManagement 顶部、BOM import 之前的显式声明完成 -->
        <tomcat.version>10.1.60</tomcat.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <log4j2.version>2.26.1</log4j2.version>
        <picocli.version>4.7.7</picocli.version>
        <!-- 与 Spring Boot 3.5.16 管理的 Hibernate 6.6.x 对齐（BOM 的 properties 不会随 import 继承，需显式声明） -->
        <hibernate.version>6.6.53.Final</hibernate.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
        <springdoc.version>2.9.1</springdoc.version>
        <!-- 静态检查:格式(Spotless/google-java-format)+ 规约(P3C)+ 兜底(Checkstyle) -->
        <spotless.version>2.44.5</spotless.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <!-- p3c-pmd 2.1.1 未适配 PMD 7,maven-pmd-plugin 锁最后一个内置 PMD 6.55.0 的 3.21.2 -->
        <maven-pmd-plugin.version>3.21.2</maven-pmd-plugin.version>
        <p3c.version>2.1.1</p3c.version>
        <!-- PMD 6.55.0 自身硬锁 asm 9.4(只认到 class major 64 / Java 20),而本项目 release=21
             编出的 class 是 major 65:类型解析阶段读 auxclasspath(= target/classes)时逐文件抛
             "Unsupported class file major version 65"。PMD 默认 skipPmdError=true 把这类错误
             只当 WARNING,于是 P3C 门禁"全挂 = 零违规 = 通过"地静默空转。此处显式覆盖到 9.5+
             (9.7.1 支持到 Java 23,留升级余量);仅作用于 pmd 插件自身 classpath,不进产物。
             移除条件:p3c-pmd 适配 PMD 7(届时不再需要 PMD 6.55)或弃用 P3C 时。 -->
        <asm.version>9.7.1</asm.version>
        <!-- 安全检查:SpotBugs + Find Security Bugs + OWASP Dependency-Check(源码层规则由 P3C 承载) -->
        <spotbugs-maven-plugin.version>4.8.6.6</spotbugs-maven-plugin.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <dependency-check.version>12.1.0</dependency-check.version>
        <!-- NVD API 限流严格,本地可用 -Ddependency-check.skip=true 跳过;CI 用 NVD_API_KEY 全量扫 -->
        <dependency-check.skip>false</dependency-check.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- CVE 修复版覆盖(2026-10-12):BOM import 模式下 BOM 的 ${tomcat.version} 等属性
                 在其自身模型内完成插值,本项目同名属性覆盖不生效,必须在 BOM 之前显式声明
                 (dependencyManagement 声明在前者优先);Boot 升级吸纳这些版本后删除本组覆盖 -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <!-- log4j-api/log4j-to-slf4j 修复 CVE-2026-34478~34481(影响 ≤2.25.3,2.25.4 起修复);
                 以 log4j-bom 统一版本,Boot 升级吸纳后删除 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI 只用一半：Provider 抽象 + 协议转换 + @Tool schema 生成（BOM 先行，模块依赖随 US-1 落地） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-community-dialects</artifactId>
                <version>${hibernate.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>

            <!-- 内部模块统一版本 -->
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-channel-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.oryxlabs</groupId>
                <artifactId>oryxos-boot</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <!-- oryxos-cli 打成可执行 fat JAR（内嵌 picocli），使 java -jar 可直接运行 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- 格式层:Spotless + google-java-format(GOOGLE 风格),管「长什么样」,spotless:apply 一键自动修 -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <style>GOOGLE</style>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <importOrder/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- 编码规约层:阿里 P3C(挂在 PMD 上),管「怎么写才对」;个别风格规则与
                     google-java-format 冲突时以 google-java-format 为准(它能自动修) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin.version}</version>
                    <configuration>
                        <rulesets>
                            <!-- p3c-pmd jar 内无聚合 ruleset:自定义 p3c-ruleset.xml 逐一引用全量 10 个分类,
                                 并排除 ClassMustHaveAuthorRule(排除理由见该文件注释) -->
                            <ruleset>${maven.multiModuleProjectDirectory}/p3c-ruleset.xml</ruleset>
                        </rulesets>
                        <printFailingErrors>true</printFailingErrors>
                        <!-- PMD 解析/类型解析错误默认被吞成 WARNING(默认值 true),会让工具链不兼容
                             表现为"门禁绿灯空转"(见 asm.version 属性注释)。改为 false:此类错误直接红 -->
                        <skipPmdError>false</skipPmdError>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.alibaba.p3c</groupId>
                            <artifactId>p3c-pmd</artifactId>
                            <version>${p3c.version}</version>
                        </dependency>
                        <!-- 覆盖 PMD 6.55.0 自带的 asm 9.4,否则 Java 21 字节码类型解析全挂 -->
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- 兜底:Checkstyle google_checks(内置 severity=warning,只报告不阻断) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <configuration>
                        <configLocation>google_checks.xml</configLocation>
                        <consoleOutput>true</consoleOutput>
                        <failsOnError>true</failsOnError>
                    </configuration>
                    <executions>
                        <execution>
                            <id>checkstyle-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- 字节码安全扫描:SpotBugs + Find Security Bugs(覆盖 OWASP Top 10:
                     SQL 注入、XSS、路径穿越、弱加密、XXE、不安全反序列化等) -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotbugs-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- 第三方依赖已知 CVE 扫描:CVSS ≥ 7 阻断;只在根模块聚合执行(inherited=false) -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <skip>${dependency-check.skip}</skip>
                        <!-- 误报/不可达 CVE 抑制清单,每条附理由与移除条件,见文件头注释 -->
                        <suppressionFiles>
                            <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                        </suppressionFiles>
                        <!-- 禁用 RetireJS 前端库分析器:Maven 反应堆为纯 Java(唯一 JS 资产是
                             swagger-ui webjar,版本由 springdoc 钉死);且其数据源
                             raw.githubusercontent.com 国内网络不可达,启用会拖垮本地构建。
                             website/ 前端依赖安全由 npm 生态(npm audit)另行负责 -->
                        <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                        <!-- 禁用 .NET Assembly 分析器:纯 Java 工程,仅 sqlite-jdbc 内嵌原生 DLL,
                             本机无 dotnet 会报初始化错误噪音 -->
                        <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                        <!-- 禁用 Sonatype OSS Index 分析器:2025 起其 API 强制认证(401),
                             未提供账号时会把构建打挂;CVE 主数据源 NVD 不受影响。
                             后续若注册 Sonatype 账号,可配置 ossIndexServerId 后重新启用 -->
                        <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- 以下插件全模块继承生效,任一失败即阻断 mvn verify(章程质量门禁) -->
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <!-- 依赖 CVE 扫描只在根模块聚合一次(逐模块跑会重复下载 NVD 数据) -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>owasp-depcheck</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
