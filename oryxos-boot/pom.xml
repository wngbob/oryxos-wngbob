<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.oryxlabs</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>oryxos-boot</artifactId>
    <name>oryxos-boot</name>
    <description>Spring Boot 启动模块：OryxosApplication 入口、自动配置、依赖聚合；打包产出单 fat JAR（oryxos.jar）</description>

    <dependencies>
        <!-- 依赖聚合：全部能力模块 -->
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-channel-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-cli</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 可观测：Actuator + Prometheus 指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- 结构化 JSON 日志（prod profile） -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- 产出 oryxos.jar（单二进制部署） -->
        <finalName>oryxos</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
