<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.oryxlabs</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>oryxos-provider</artifactId>
    <name>oryxos-provider</name>
    <description>能力一（对接 LLM）：ProviderService、Function Calling 适配、provider name 显式映射。Spring AI Alibaba 依赖在 US-1 落地时引入（仅用协议转换 + @Tool schema 生成）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 契约在 core、实现在能力模块：ProviderService 依赖 core 的 OryxTool 契约与 Profile -->
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- oryxos-storage 是共享基础设施模块（审计实体 + Repository） -->
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring AI 只用一半：Provider 抽象 + 协议转换 + 工具 schema 生成。
             刻意不引 spring-ai-starter-model-deepseek——其自动配置会产出按类型注入的
             ChatModel Bean，与章程原则 III「provider name 显式映射、禁止类型扫描」冲突。
             版本由根 pom 的 spring-ai-bom 托管，此处不写版本号。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-deepseek</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
