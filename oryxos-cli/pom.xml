<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.oryxlabs</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>oryxos-cli</artifactId>
    <name>oryxos-cli</name>
    <description>命令行工具：Picocli 主入口 OryxOsCli、12 个子命令、ConfigLoader（统一加载敏感配置，${ENV_VAR} 占位解析）</description>

    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!--
          重命令（chat / serve / gateway）要启动 Spring 上下文，故本模块需要 starter；
          轻命令（init / status / profile * / provider list / tool list / session list）不走 Spring。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          七个能力模块：CliAssemblyConfiguration 显式装配它们，命令类从上下文取 Bean。
          （修订注，2026-10-19，第 26 节）第 18 节这里写着「MUST NOT 加 oryxos-web —— 本节不起 Web 容器（仲裁 15）」，
          那是当时节内范围的表述，原文不重写。第 26 节起 `serve` 要起 SERVLET 容器并扫到
          io.oryxlabs.oryxos.web 下的 @RestController，故补上这条依赖边；`chat` / `gateway` 仍显式用
          WebApplicationType.NONE，不会因此起端口。
        -->
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-channel-cli</artifactId>
        </dependency>

        <!--
          jackson-databind：notify-channel add 要把 config 选项的键值对序列化成 config_json。
          这本是既有传递边（经 oryxos-tool），这里显式化——与 oryxos-tool 把 spring-web / oryxos-storage
          显式化是同一条纪律：直接 import 的类型就该有直接的依赖边，发行物不新增任何工件。
          版本由 Spring Boot BOM 管，不写 version。不手写 JSON 转义：那是必然写错一处的那类代码。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
          @SuppressFBWarnings：轻命令的原生 JDBC（WorkspaceDb）必然撞上 FindSecBugs 的 SQL_INJECTION_JDBC——
          它的判据是「SQL 是否为编译期常量」，而建表脚本按 research D8 必须从 classpath 的 db/schema.sql 切出来，
          天然非常量；换成 PreparedStatement 同样会被报。SQL 全部来自本仓自己的常量与本仓自己的脚本，无外部输入。
          纯注解、provided 作用域，不进产物、不引入运行时依赖（与 oryxos-core 同一款、同一版本，父 pom 已管）。
        -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          第 20 节起本模块有测试：装配测试必须起真实 Spring 上下文。
          为什么必须起真上下文：@ConditionalOnMissingBean 的让位机制、@Bean 声明顺序约束，
          都只在真上下文里才求值——用 AnnotationConfigApplicationContext 手工注册的等价物会把这
          两条最易踩的坑绕过去，测试就变成自证。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 开启资源过滤：把 ${project.version} 注入 oryxos-version.properties -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <!--
          本节起本模块退回普通库模块：不再自打 fat JAR。
          唯一发行物是 oryxos-boot 的 fat JAR（其 spring-boot-maven-plugin 显式声明 <mainClass> 指向
          OryxOsCli）。理由：application.yaml 只在 oryxos-boot，重命令要读 spring.datasource.* 与
          oryxos.providers，二者必须与 CLI 的类同 classpath；本模块若自打 fat JAR，那个 jar 的 classpath
          上没有 application.yaml，重命令会在 DataSource 自动装配阶段失败（见 contracts/cli-assembly.md §1）。
          MUST NOT 恢复 shade 插件、MUST NOT 在本模块放第二份 application.yaml。
        -->
    </build>
</project>
