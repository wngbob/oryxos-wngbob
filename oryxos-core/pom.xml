<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.oryxlabs</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>oryxos-core</artifactId>
    <name>oryxos-core</name>
    <description>核心抽象与引擎：OryxTool / Session / Profile / AgentLoader / ContextLoader / ReActLoop / PromptBuilder / ToolExecutor / AgentService / AgentScheduler</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- AGENT.md frontmatter 解析 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!--
          ReActLoop 要构造 Prompt、读 ChatResponse，PromptBuilder 要产出 ToolCallback。
          这是「依赖 Spring AI 的类型」，不是「依赖 oryxos-provider 模块」——依赖方向不受影响。
          自动工具执行开关不在 core 侧设置，由 oryxos-provider 单点关闭。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <!--
          共享基础设施模块（000-runtime-kernel plan U4）：core 直接依赖它写 tool_invocations 审计。
          storage 不反向依赖 core，故不成环。
        -->
        <dependency>
            <groupId>io.oryxlabs</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>

        <!--
          @SuppressFBWarnings：只为豁免 SpotBugs 对「持有协作对象」的 EI_EXPOSE_REP2 误报（理由见父 pom）。
          纯注解、provided 作用域，不进产物、不引入运行时依赖。
        -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
